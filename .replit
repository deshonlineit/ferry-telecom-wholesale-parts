modules = ["nodejs-24", "python-base-3.13", "php-8.4", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "isolation-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck-api"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "stock-race-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "smartwatch-search-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "profile-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "native-header-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "generated-api-schema"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "native-header-zoom"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-codegen-drift"

[[workflows.workflow]]
name = "isolation-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node artifacts/api-server/tests/isolation.test.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck-api"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "stock-race-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node artifacts/api-server/tests/stock-race.test.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "smartwatch-search-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node artifacts/api-server/tests/smartwatch-search.test.mjs"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "profile-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:profile"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "native-header-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/parts-store run test:native-header"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "generated-api-schema"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm exec tsc -b lib/api-zod lib/api-client-react --force"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "native-header-zoom"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "HEADER_ZOOM_BASE_URL=\"https://${REPLIT_DEV_DOMAIN}/test-shop/\" pnpm --filter @workspace/parts-store run test:native-header-zoom"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "api-codegen-drift"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run check:api-codegen-drift"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "mysql84", "openjpeg", "swig", "xcbuild"]
