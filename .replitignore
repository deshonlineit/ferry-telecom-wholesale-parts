# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# Local native-shop runtime data is development-only. Production reads product
# media and private documents from App Storage instead of the local filesystem.
artifacts/parts-store/native/public/media
artifacts/parts-store/native/storage
